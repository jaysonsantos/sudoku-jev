{
  "name": "sudoku-jev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:.*/\"",
    "dev:backend": "node --watch backend/src/main.ts",
    "dev:frontend": "vite",
    "build": "vite build",
    "start": "node backend/src/main.ts",
    "cf:dev": "pnpm build && wrangler dev",
    "cf:deploy": "pnpm build && wrangler deploy",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.frontend.json && tsc --noEmit -p tsconfig.cloudflare.json",
    "lint": "biome ci .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@chrisoakman/chessboardjs": "1.0.0",
    "chess.js": "1.4.0",
    "jquery": "3.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@cloudflare/workers-types": "5.20260921.1",
    "@types/jquery": "3.5.33",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  }
}
